local PV = { Enabled = false, Distance = 8, Strength = 0.01 }

local function FindBall(rootPos)
    if cachedFootball and cachedFootball.Parent then
        local dist = (cachedFootball.Position - rootPos).Magnitude
        if dist < PV.Distance then
            return cachedFootball
        end
    end
    return nil
end

local function InputHeld()
    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then return true end
    local ok, state = pcall(function() return UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1) end)
    if ok and state then
        for _, axis in ipairs(state) do
            if axis.KeyCode == Enum.KeyCode.ButtonR2 and axis.Position.Z > 0.5 then return true end
        end
    end
    return false
end

RunService.Heartbeat:Connect(function()
    if not PV.Enabled then return end
    if not InputHeld() then return end
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local hum  = character and character:FindFirstChild("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end
    local ball = FindBall(root.Position)
    if ball then
        root.CFrame = CFrame.new(root.CFrame.Position:Lerp(ball.Position, PV.Strength), ball.Position)
    end
end)

