--  STICKY HEAD (OPTIMIZED)
-- ============================================================

local stickyHeadEnabled  = false
local stickyPullStrength = 2.8
local stickyStickiness   = 2.0
local stickyJumpConn     = nil
local lastStickyTarget   = nil
local stickyThrottle     = 0

local function closestPlayerForSticky()
    local nearest, dist = nil, 35
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 and rootPart then
                local d = (hrp.Position - rootPart.Position).Magnitude
                if d < dist then dist = d nearest = p end
            end
        end
    end
    return nearest
end

local function connectStickyJump(target)
    pcall(function()
        if stickyJumpConn then stickyJumpConn:Disconnect() end
        local hum        = target.Character:FindFirstChild("Humanoid")
        local targetHead = target.Character:FindFirstChild("Head")
        if not hum or not targetHead then return end
        stickyJumpConn = hum.Jumping:Connect(function()
            if not stickyHeadEnabled then return end
            if humanoid.FloorMaterial ~= Enum.Material.Air then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
            local headPos = targetHead.Position + Vector3.new(0, 2.2, 0)
            local offset  = headPos - rootPart.Position
            rootPart.AssemblyLinearVelocity += Vector3.new(
                offset.Unit.X * (stickyPullStrength * 40), 12,
                offset.Unit.Z * (stickyPullStrength * 40)
            )
        end)
    end)
end

RunService.Heartbeat:Connect(function(dt)
    if not stickyHeadEnabled then return end
    stickyThrottle = stickyThrottle + dt
    if stickyThrottle < 0.1 then return end -- Increased from 0.05 to 0.1
    stickyThrottle = 0
    pcall(function()
        local target = closestPlayerForSticky()
        if not target or not target.Character then return end
        if target ~= lastStickyTarget then
            lastStickyTarget = target
            connectStickyJump(target)
        end
        local targetHead = target.Character:FindFirstChild("Head")
        if not targetHead then return end
        local headPos = targetHead.Position + Vector3.new(0, 1.6, 0)
        local offset  = headPos - rootPart.Position
        local dist    = offset.Magnitude
        local vel     = rootPart.AssemblyLinearVelocity
        if dist > 2.5 then
            local desired = offset.Unit * (stickyPullStrength * 14)
            rootPart.AssemblyLinearVelocity = Vector3.new(vel.X+(desired.X-vel.X)*0.2, vel.Y, vel.Z+(desired.Z-vel.Z)*0.2)
        end
        if dist <= 3 then
            local h = Vector3.new((headPos-rootPart.Position).X, 0, (headPos-rootPart.Position).Z)
            rootPart.AssemblyLinearVelocity += h.Unit*(stickyStickiness*5)
        end
        if dist <= 2 then
            local bo = headPos - rootPart.Position
            rootPart.AssemblyLinearVelocity = Vector3.new(bo.X*(stickyStickiness*5), rootPart.AssemblyLinearVelocity.Y, bo.Z*(stickyStickiness*5))
        end
        if dist <= 1.2 then
            local lock = headPos - rootPart.Position
            rootPart.AssemblyLinearVelocity = Vector3.new(lock.X*(stickyStickiness*6), rootPart.AssemblyLinearVelocity.Y, lock.Z*(stickyStickiness*6))
        end
    end)
end)

