local boostEnabled  = false
local boostPower    = 25
local boostCooldown = {}

local function isBallWeldedToPlayer()
    local char = LocalPlayer.Character
    if not char then return false end
    local ball = cachedFootball
    if not ball or not ball.Parent then return false end
    
    for _, child in pairs(ball:GetChildren()) do
        if child:IsA("WeldConstraint") or child:IsA("Weld") or child:IsA("Motor6D") then
            for _, cp in pairs(char:GetDescendants()) do
                if cp:IsA("BasePart") and (child.Part0 == cp or child.Part1 == cp) then return true end
            end
        end
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root and (ball.Position - root.Position).Magnitude < 3.5 then
        if (ball.AssemblyLinearVelocity - root.AssemblyLinearVelocity).Magnitude < 4 then return true end
    end
    return false
end

local function setupBoostDetection()
    if not rootPart then return end
    rootPart.Touched:Connect(function(hit)
        if not boostEnabled then return end
        if not isBallWeldedToPlayer() then return end
        local otherPlayer = Players:GetPlayerFromCharacter(hit.Parent)
        if otherPlayer and otherPlayer ~= LocalPlayer then
            if boostCooldown[otherPlayer.Name] and tick() - boostCooldown[otherPlayer.Name] < 1 then return end
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(0, math.huge, 0)
            bv.Velocity = Vector3.new(0, boostPower, 0)
            bv.Parent   = rootPart
            boostCooldown[otherPlayer.Name] = tick()
            task.delay(0.2, function() if bv and bv.Parent then bv:Destroy() end end)
        end
    end)
end
setupBoostDetection()

LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    rootPart      = char:FindFirstChild("HumanoidRootPart")
    boostCooldown = {}
    setupBoostDetection()
end)

