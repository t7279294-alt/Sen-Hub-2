local customName       = ""
local processedObjects = {}

local function applyToTextObject(obj)
    if processedObjects[obj] then return end
    if customName == "" or #customName < 3 then return end
    if obj:IsA("TextLabel") or obj:IsA("TextBox") or obj:IsA("TextButton") then
        local lower = string.lower(obj.Text)
        if string.find(lower, string.lower(LocalPlayer.Name)) or
           string.find(lower, string.lower(LocalPlayer.DisplayName)) then
            obj.Text = customName
            processedObjects[obj] = true
            obj:GetPropertyChangedSignal("Text"):Connect(function()
                if obj.Text ~= customName and customName ~= "" then obj.Text = customName end
            end)
        end
    end
end

local function applyNameChange()
    if customName == "" or #customName < 3 then return end
    for _, v in pairs(LocalPlayer.PlayerGui:GetDescendants()) do pcall(function() applyToTextObject(v) end) end
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BillboardGui") or v:IsA("SurfaceGui") then
            for _, child in pairs(v:GetDescendants()) do pcall(function() applyToTextObject(child) end) end
        end
    end
end

LocalPlayer.PlayerGui.DescendantAdded:Connect(function(v)
    if customName ~= "" and #customName >= 3 then
        task.defer(function() pcall(function() applyToTextObject(v) end) end)
    end
end)

workspace.DescendantAdded:Connect(function(v)
    if customName ~= "" and #customName >= 3 then
        if v:IsA("BillboardGui") or v:IsA("SurfaceGui") then
            task.defer(function() for _, c in pairs(v:GetDescendants()) do pcall(function() applyToTextObject(c) end) end end)
        end
        task.defer(function() pcall(function() applyToTextObject(v) end) end)
    end
end)

