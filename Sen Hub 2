local ballboxEnabled       = false
local ballboxSize          = 4
local ballboxTarget        = nil
local ballboxOrigBallTrans = nil
local ballboxParts         = {}
local ballboxConns         = {}
local ballboxThread        = nil

local function isBallLoose(ball)
    if not ball or not ball.Parent then return false end
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            if root and (root.Position - ball.Position).Magnitude < 3.5 then
                if (ball.AssemblyLinearVelocity - root.AssemblyLinearVelocity).Magnitude < 5 then return false end
            end
            for _, child in pairs(ball:GetChildren()) do
                if child:IsA("WeldConstraint") or child:IsA("Weld") or child:IsA("Motor6D") then
                    for _, cp in pairs(player.Character:GetDescendants()) do
                        if cp:IsA("BasePart") and (child.Part0 == cp or child.Part1 == cp) then return false end
                    end
                end
            end
        end
    end
    return true
end

local function ballboxClearParts()
    if ballboxTarget and ballboxTarget.Parent and ballboxOrigBallTrans ~= nil then
        pcall(function() ballboxTarget.Transparency = ballboxOrigBallTrans end)
    end
    ballboxOrigBallTrans = nil
    for _, p in ipairs(ballboxParts) do pcall(function() if p and p.Parent then p:Destroy() end end) end
    ballboxParts = {}
end

local function ballboxClearConns()
    for _, c in ipairs(ballboxConns) do pcall(function() if c then c:Disconnect() end end) end
    ballboxConns = {}
end

local function ballboxBuild(ball)
    ballboxClearParts()
    local sz = ballboxSize
    ballboxOrigBallTrans = ball.Transparency
    local vis = Instance.new("Part")
    vis.Name = "BallboxVis" vis.Size = Vector3.new(sz,sz,sz)
    vis.Transparency = 0.55 vis.Color = Color3.fromRGB(0,200,255)
    vis.Material = Enum.Material.Neon vis.CanCollide = false
    vis.CanTouch = false vis.Massless = true vis.CastShadow = false
    vis.Anchored = true vis.CFrame = CFrame.new(ball.Position)
    vis.Parent = workspace
    table.insert(ballboxParts, vis)
    local hitbox = Instance.new("Part")
    hitbox.Name = "BallboxHitbox" hitbox.Size = Vector3.new(sz*1.6,sz*1.6,sz*1.6)
    hitbox.Transparency = 1 hitbox.CanCollide = false hitbox.CanTouch = true
    hitbox.Massless = true hitbox.CastShadow = false hitbox.Anchored = true
    hitbox.CFrame = CFrame.new(ball.Position) hitbox.Parent = workspace
    table.insert(ballboxParts, hitbox)
    local fc = RunService.Heartbeat:Connect(function()
        if not ball or not ball.Parent then return end
        local pos = ball.Position
        if vis    and vis.Parent    then vis.CFrame    = CFrame.new(pos) end
        if hitbox and hitbox.Parent then hitbox.CFrame = CFrame.new(pos) end
    end)
    table.insert(ballboxConns, fc)
    local ac = ball.AncestryChanged:Connect(function()
        if not ball.Parent then ballboxClearParts() ballboxTarget = nil end
    end)
    table.insert(ballboxConns, ac)
end

local function ballboxTick()
    local ball  = cachedFootball
    local loose = ball and isBallLoose(ball)
    if not loose then
        if ballboxTarget then ballboxClearConns() ballboxClearParts() ballboxTarget = nil end
        return
    end
    if ball ~= ballboxTarget then
        ballboxClearConns() ballboxClearParts()
        ballboxTarget = ball
        pcall(function() ballboxBuild(ball) end)
    else
        pcall(function()
            local sz = ballboxSize
            for _, p in ipairs(ballboxParts) do
                if p and p.Parent then
                    if p.Name == "BallboxVis"    then p.Size = Vector3.new(sz,sz,sz) end
                    if p.Name == "BallboxHitbox" then p.Size = Vector3.new(sz*1.6,sz*1.6,sz*1.6) end
                end
            end
        end)
    end
end

local function ballboxEnable()
    ballboxEnabled = true
    if ballboxThread then pcall(function() task.cancel(ballboxThread) end) end
    ballboxThread = task.spawn(function()
        while ballboxEnabled do 
            pcall(ballboxTick) 
            task.wait(0.25) -- Increased from 0.08 to 0.25 for better performance
        end
    end)
    local dc = workspace.DescendantAdded:Connect(function(obj)
        if ballboxEnabled and obj:IsA("BasePart") and obj.Name == "Football" then 
            task.wait(0.2) 
            pcall(ballboxTick) 
        end
    end)
    table.insert(ballboxConns, dc)
    local cc = LocalPlayer.CharacterAdded:Connect(function()
        task.wait(1.5) 
        if ballboxEnabled then pcall(ballboxTick) end
    end)
    table.insert(ballboxConns, cc)
end

local function ballboxDisable()
    ballboxEnabled = false
    if ballboxThread then pcall(function() task.cancel(ballboxThread) end) ballboxThread = nil end
    ballboxClearConns() ballboxClearParts() ballboxTarget = nil
end

