    if not forceSpeedEnabled then return end
    if forceSpeedCooldown then return end
    if isListeningForKey then return end
    if forceSpeedKeybind == nil then return end
    if input.KeyCode ~= forceSpeedKeybind then return end

    local char = LocalPlayer.Character
    local hum  = char and char:FindFirstChild("Humanoid")
    if not hum then return end

    forceSpeedCooldown = true
    local baseSpeed    = hum.WalkSpeed
    hum.WalkSpeed = forceSpeedAmount

    task.delay(forceSpeedDuration, function()
        local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if h then h.WalkSpeed = LoopSpeed.Enabled and LoopSpeed.Speed or baseSpeed end
        forceSpeedCooldown = false
    end)
end)

